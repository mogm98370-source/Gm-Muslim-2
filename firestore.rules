rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'larblaablaybla@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // User document & subcollections
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid);
      allow delete: if isAdmin();
      
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /readingProgress/{progressId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /library/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /inventory/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Official 1-on-1 GM Support Conversations & Messages
    match /supportConversations/{conversationId} {
      allow read: if isAuthenticated() && (request.auth.uid == conversationId || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == conversationId || request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == conversationId || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == conversationId || isAdmin());
      }
    }

    // Support Tickets (Legacy & Migration)
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Products Store Collection
    match /products/{productId} {
      allow read: if true;
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salesCount']));
      allow create, delete: if isAdmin();
    }

    // Inventory & Purchase Logs
    match /inventoryLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Mail and In-App System Rewards
    match /mail/{mailId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
    }

    // Points and Gems Transaction History
    match /pointTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Islamic Content: Adhkar & Duas
    match /adhkar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /duas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo Codes & Gifts
    match /codes/{codeId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Global Config
    match /appSettings/config {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
